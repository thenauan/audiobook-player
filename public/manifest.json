{
  "name": "Audiobook Player",
  "short_name": "AudiobookPlayer",
  "description": "Reprodutor de audiobooks gratuito com capítulos, texto sincronizado, marcações, fila e timer. Em português, inglês, espanhol, russo e árabe.",
  "start_url": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#04070f",
  "theme_color": "#090d16",
  "icons": [
    {
      "src": "icons/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/app-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/logo-white.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "categories": [
    "books",
    "entertainment",
    "music"
  ],
  "scope": "./",
  "id": "./",
  "lang": "pt-BR",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "audio/*",
            ".mp3",
            ".m4a",
            ".m4b",
            ".mp4",
            ".aac",
            ".ogg",
            ".oga",
            ".opus",
            ".wav",
            ".flac",
            ".wma",
            ".lrc",
            ".srt",
            ".vtt",
            ".json",
            ".smil",
            ".epub",
            "application/epub+zip",
            "application/json",
            "text/plain",
            "text/vtt"
          ]
        }
      ]
    }
  }
}